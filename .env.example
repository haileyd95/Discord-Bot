# ─────────────────────────────────────────────────────────────────────────────
# Support Queue Bot — environment variables
# Copy this file to .env and fill in every value before starting the bot.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Server (guild) ID — REQUIRED — right-click your server icon → Copy Server ID
GUILD_ID=123456789012345678

# ── Channel IDs ───────────────────────────────────────────────────────────────
# #welcome-read-first  — where the "Request Support" button panel is posted
WELCOME_CHANNEL_ID=123456789012345678

# Queue board — where new ticket embeds appear and users are pinged on /call
QUEUE_BOARD_CHANNEL_ID=123456789012345678

# #ops-log — where operator actions are logged
OPS_LOG_CHANNEL_ID=123456789012345678

# Static voice channel for users waiting to be called into the operator room.
# Ticket holders who are already in voice are staged here first.
WAITING_ROOM_CHANNEL_ID=123456789012345678

# Private voice channel where the operator and ticket holder conduct the call.
# Configure its permissions in Discord once (deny @everyone; allow Operator role).
# The bot moves users in/out but never creates or deletes this channel.
OPERATOR_ROOM_CHANNEL_ID=123456789012345678

# ── Role IDs ──────────────────────────────────────────────────────────────────
# Assigned when a user joins the queue; removed on complete/drop/skip(x2)
QUEUED_ROLE_ID=123456789012345678

# Granted to the user when their ticket is marked /complete
VERIFIED_ROLE_ID=123456789012345678

# Members with this role can use operator-only commands (/call, /complete, etc.)
OPERATOR_ROLE_ID=123456789012345678
